title: Переломный момент
is-hand: true
on-arrival: {!
Q.turn += 1;
if (Q.time_scale == 'week') {
    Q.day += 7;
    if (Q.day > 30) { Q.day -= 30; Q.month += 1; }
    if (Q.month > 12) { Q.month = 1; Q.year += 1; }
} else {
    Q.day += 1;
    if (Q.day > 30) { Q.day = 1; Q.month += 1; }
}
if (Q.year == 1996 && Q.month == 6 && Q.day >= 1 && Q.time_scale == 'week') {
    Q.time_scale = 'day'; Q.day = 1;
}
for (var timer of Q.timers) {
    if (Q[timer + '_timer'] > 0) Q[timer + '_timer'] -= 1;
}
!}

{!<div class="scrollable-box">!}

= Россия, {! Q.day !} {! Q.month == 1 ? 'января' : Q.month == 2 ? 'февраля' : Q.month == 3 ? 'марта' : Q.month == 4 ? 'апреля' : Q.month == 5 ? 'мая' : Q.month == 6 ? 'июня' : 'июля' !} {! Q.year !} года

