    Q.region_data[rid] = { yelt: 8, zyug: 22, lebe: 10, yavl: 11, zhir: 12, others: 37 };
}

Q.timers = ['regional_visit', 'agitation', 'negotiation', 'patriotic_forces', 'advisor_action', 'davos', 'food_campaign', 'belovezha'];
for (var t of Q.timers) Q[t + '_timer'] = 0;

Q.player_candidate = '';
Q.advisor_zhirinovsky = 1;
Q.advisor_lebed = 1;
Q.advisor_yavlinsky = 1;
Q.advisor_fyodorov = 1;

Q.historical_mode = 1;
