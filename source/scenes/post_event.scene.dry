title: Обработка хода
new-page: true

@post_event_start
on-arrival: {!
// Продвижение времени
Q.day += Q.turn_length;
if (Q.day > 30) {
    Q.day -= 30;
    Q.month += 1;
}
if (Q.month > 12) {
    Q.month = 1;
    Q.year += 1;
}

// Обновление таймеров
if (Q.negotiations_timer > 0) Q.negotiations_timer -= 1;
if (Q.regional_visit_timer > 0) Q.regional_visit_timer -= 1;
if (Q.advisor_action_timer > 0) Q.advisor_action_timer -= 1;

// Сброс действий
Q.actions_this_turn = 0;
Q.time += 1;

// Пересчёт дней до выборов
Q.days_to_election = (Q.first_round_month - Q.month) * 30 + (Q.first_round_day - Q.day);
if (Q.days_to_election < 0) Q.days_to_election = 0;

// Случайные колебания рейтингов
Q.player_support += (Math.random() - 0.5) * 1;
Q.yeltsin_support += (Math.random() - 0.5) * 1;

// Проверка границ
if (Q.player_support < 0) Q.player_support = 0;
if (Q.yeltsin_support < 0) Q.yeltsin_support = 0;

// Форматирование даты
var monthNames = ['', 'января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];
Q.date_display = Q.day + ' ' + monthNames[Q.month] + ' ' + Q.year;

// Проверка событий
Q.has_event = 0;

// Объявление кандидата от власти
if (!Q.power_candidate_announced && Q.month >= 2 && Q.day >= 15) {
    Q.power_announcement_event = 1;
    Q.has_event = 1;
}

// Первый тур
if (Q.month == Q.first_round_month && Q.day >= Q.first_round_day && !Q.first_round_completed) {
    Q.first_round_event = 1;
    Q.has_event = 1;
}
!}
go-to: events_choice if has_event = 1; main if has_event = 0

= [+ date_display +]

@events_choice

- #event

@power_announcement
tags: event
title: Объявление кандидата от партии власти
view-if: power_announcement_event = 1
on-arrival: power_announcement_event = 0; power_candidate_announced = 1; power_candidate = "Ельцин"; yeltsin_status = 1
priority: 10
go-to: power_announcement_scene

@first_round_card
tags: event
title: Первый тур выборов
view-if: first_round_event = 1
on-arrival: first_round_event = 0
priority: 10
go-to: election_simulation

@continue_card
tags: event
title: Продолжить...
priority: 0
go-to: main

@power_announcement_scene
new-page: true

= Кандидат от партии власти

15 февраля 1996 года. Кремль объявил о своём решении.

Борис Николаевич Ельцин официально объявил о своём выдвижении на второй срок. Несмотря на катастрофически низкий рейтинг, действующий президент решил бороться за власть.

Это будет тяжёлая борьба. За Ельциным — весь административный ресурс государства и поддержка крупного капитала.

- @main: Продолжить
