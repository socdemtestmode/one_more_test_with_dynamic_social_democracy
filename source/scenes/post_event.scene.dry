title: Post Event
new-page: true
on-arrival: {!
// Расчет поддержки для отображения в статус-баре (если используется)
// В нашей игре мы перенесли основную логику в election_algorithm.scene.dry
// Но для корректной работы движка и переходов оставим базовую структуру.

Q.has_event = 0;
var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene);
if (choices && choices[0].title != "Continue...") {
    Q.has_event = 1;
} else {
    Q.has_event = 0;
}
!}
go-to: events_choice if has_event = 1; main if has_event = 0

@events_choice

- #event
