title: Алгоритм выборов
on-arrival: {!
// ===== АЛГОРИТМ РАСЧЁТА РЕЗУЛЬТАТОВ ГОЛОСОВАНИЯ =====

// Функция расчёта поддержки кандидата по демографическим группам
function calculateDemographicSupport(candidateBase, demographicPreferences, demographicSizes) {
    var totalSupport = 0;
    var totalWeight = 0;
    
    for (var demo in demographicPreferences) {
        var preference = demographicPreferences[demo];
        var size = demographicSizes[demo];
        totalSupport += (candidateBase * preference / 100) * size;
        totalWeight += size;
    }
    
    return totalSupport / totalWeight;
}

// Собираем данные по демографическим группам
var demoPrefs = {
    workers: Q.workers_preference,
    traders: Q.traders_preference,
    budgetniki: Q.budgetniki_preference,
    intelligentsia: Q.intelligentsia_preference,
    military: Q.military_preference,
    new_russians: Q.new_russians_preference,
    pensioners: Q.pensioners_preference,
    youth: Q.youth_preference
};

var demoSizes = {
    workers: Q.workers_size,
    traders: Q.traders_size,
    budgetniki: Q.budgetniki_size,
    intelligentsia: Q.intelligentsia_size,
    military: Q.military_size,
    new_russians: Q.new_russians_size,
    pensioners: Q.pensioners_size,
    youth: Q.youth_size
};

// Расчёт модификаторов на основе кампании
var campaignModifier = 0;
if (Q.campaign_slogan) campaignModifier += 1;
if (Q.program_adopted) campaignModifier += 2;
if (Q.davos_visited && Q.davos_speech_type == 1) campaignModifier += 1;

// Расчёт модификаторов на основе коалиций
var coalitionModifier = 0;
if (Q.coalition_with_lebed) {
    coalitionModifier += Q.lebed_support * 0.7; // 70% электората переходит
    Q.lebed_support = Q.lebed_support * 0.3; // Остаётся 30%
}
if (Q.coalition_with_yavlinsky) {
    coalitionModifier += Q.yavlinsky_support * 0.55; // 55% электората переходит
    Q.yavlinsky_support = Q.yavlinsky_support * 0.45;
}
if (Q.coalition_with_zhirinovsky) {
    coalitionModifier += Q.zhirinovsky_support * 0.4; // 40% электората переходит
    Q.zhirinovsky_support = Q.zhirinovsky_support * 0.6;
}

// Модификатор административного ресурса
var adminModifier = -Q.admin_pressure * 0.5;

// Модификатор "красной угрозы"
var redScareModifier = -Q.red_scare * 0.1;

// Модификатор на основе радикализма
var radicalismModifier = 0;
if (Q.radicalism > 7) {
    radicalismModifier = -(Q.radicalism - 7) * 1.5; // Штраф за излишний радикализм
}

// Итоговый расчёт поддержки игрока
Q.player_final_support = Q.player_support + campaignModifier + coalitionModifier + adminModifier + redScareModifier + radicalismModifier;

// Проверка на отрицательные значения
if (Q.player_final_support < 0) Q.player_final_support = 0;
if (Q.player_final_support > 100) Q.player_final_support = 100;

// Расчёт поддержки Ельцина
var yeltsinBonus = 0;
if (Q.oligarch_conspiracy) yeltsinBonus += 15;
if (Q.black_pr_campaign) yeltsinBonus += 5;
yeltsinBonus += Q.admin_pressure * 0.8;

Q.yeltsin_final_support = Q.yeltsin_support + yeltsinBonus;

// Нормализация всех результатов до 100%
var totalSupport = Q.player_final_support + Q.yeltsin_final_support;
if (Q.candidate_short !== "zyuganov") {
    totalSupport += Q.zyuganov_support;
}
totalSupport += Q.lebed_support + Q.yavlinsky_support + Q.zhirinovsky_support;
totalSupport += Q.minor_candidates_support;
totalSupport += Q.others_support;

// Нормализация
Q.player_votes = (Q.player_final_support / totalSupport) * 100;
Q.yeltsin_votes = (Q.yeltsin_final_support / totalSupport) * 100;
Q.lebed_votes = (Q.lebed_support / totalSupport) * 100;
Q.yavlinsky_votes = (Q.yavlinsky_support / totalSupport) * 100;
Q.zhirinovsky_votes = (Q.zhirinovsky_support / totalSupport) * 100;
Q.others_votes = ((Q.minor_candidates_support + Q.others_support) / totalSupport) * 100;

// Округление
Q.player_votes = Math.round(Q.player_votes * 100) / 100;
Q.yeltsin_votes = Math.round(Q.yeltsin_votes * 100) / 100;
Q.lebed_votes = Math.round(Q.lebed_votes * 100) / 100;
Q.yavlinsky_votes = Math.round(Q.yavlinsky_votes * 100) / 100;
Q.zhirinovsky_votes = Math.round(Q.zhirinovsky_votes * 100) / 100;
Q.others_votes = Math.round(Q.others_votes * 100) / 100;

// Расчёт абсолютных голосов (при явке)
var totalVoters = 108000000; // Примерно 108 млн избирателей
var actualVoters = totalVoters * Q.expected_turnout / 100;

Q.player_absolute_votes = Math.round(actualVoters * Q.player_votes / 100);
Q.yeltsin_absolute_votes = Math.round(actualVoters * Q.yeltsin_votes / 100);

// Определение победителя первого тура
Q.first_round_winner = "";
Q.second_round_needed = true;

if (Q.player_votes > 50) {
    Q.first_round_winner = Q.candidate;
    Q.second_round_needed = false;
} else if (Q.yeltsin_votes > 50) {
    Q.first_round_winner = "Ельцин";
    Q.second_round_needed = false;
}

// Определение финалистов второго тура
var results = [
    {name: Q.candidate, votes: Q.player_votes},
    {name: "Ельцин", votes: Q.yeltsin_votes},
    {name: "Лебедь", votes: Q.lebed_votes},
    {name: "Явлинский", votes: Q.yavlinsky_votes},
    {name: "Жириновский", votes: Q.zhirinovsky_votes}
];

results.sort(function(a, b) { return b.votes - a.votes; });

Q.first_place = results[0].name;
Q.first_place_votes = results[0].votes;
Q.second_place = results[1].name;
Q.second_place_votes = results[1].votes;
!}
go-to: jumpScene
