title: Алгоритм выборов
on-arrival: {!
// --- 1. ВНЕШНИЕ МОДИФИКАТОРЫ ---
var momentum_yelt = 1.0;
var momentum_zyug = 1.0;

// Олигархический пакт (Семибанкирщина)
if (Q.month >= 3) {
    momentum_yelt += 0.2;
}

// Страх перед коммунизмом бьет по Зюганову
if (Q.fear_of_communism > 30) {
    momentum_zyug -= (Q.fear_of_communism - 30) / 200;
}

// Радикализм мобилизует ядро, но пугает колеблющихся
if (Q.radicalism > 50) {
    momentum_zyug -= 0.1;
} else if (Q.moderation > 60) {
    momentum_zyug += 0.15;
}

// --- 2. РЕГИОНАЛЬНЫЙ ДРЕЙФ К ЦЕЛЯМ ---
// Каждую неделю мы немного приближаемся к историческому результату
// Это симулирует естественный ход кампании

for (var rid in Q.region_data) {
    var cur = Q.region_data[rid];
    var target = Q.region_targets[rid];

    // Дрейф (примерно за 20 ходов-недель)
    cur.yelt += (target.yelt - cur.yelt) * 0.05 * momentum_yelt;
    cur.zyug += (target.zyug - cur.zyug) * 0.05 * momentum_zyug;
    cur.lebe += (target.lebe - cur.lebe) * 0.05;
    cur.yavl += (target.yavl - cur.yavl) * 0.05;
    cur.zhir += (target.zhir - cur.zhir) * 0.05;

    // Нормализация региона (чтобы сумма была ~95, остаток 5% на мелких)
    var r_sum = cur.yelt + cur.zyug + cur.lebe + cur.yavl + cur.zhir;
    var r_multiplier = 95.0 / r_sum;
    cur.yelt *= r_multiplier;
    cur.zyug *= r_multiplier;
    cur.lebe *= r_multiplier;
    cur.yavl *= r_multiplier;
    cur.zhir *= r_multiplier;
}

// --- 3. АГРЕГАЦИЯ НАЦИОНАЛЬНОГО УРОВНЯ ---
var total_yelt = 0;
var total_zyug = 0;
var total_lebe = 0;
var total_yavl = 0;
var total_zhir = 0;
var r_count = 0;

for (var rid in Q.region_data) {
    var r = Q.region_data[rid];
    total_yelt += r.yelt;
    total_zyug += r.zyug;
    total_lebe += r.lebe;
    total_yavl += r.yavl;
    total_zhir += r.zhir;
    r_count++;
}

Q.yeltsin_support = total_yelt / r_count;
Q.zyuganov_support = total_zyug / r_count;
Q.lebed_support = total_lebe / r_count;
Q.yavlinsky_support = total_yavl / r_count;
Q.zhirinovsky_support = total_zhir / r_count;

// Федоров и Прочие
Q.fyodorov_support = 1.0;
Q.others_support = 100 - (Q.yeltsin_support + Q.zyuganov_support + Q.lebed_support + Q.yavlinsky_support + Q.zhirinovsky_support + Q.fyodorov_support);

!}
