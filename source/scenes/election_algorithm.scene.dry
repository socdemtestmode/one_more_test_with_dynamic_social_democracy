title: Алгоритм выборов
on-arrival: {!
// --- 1. ТРЕНДЫ ЛОЯЛЬНОСТИ ГРУПП ---
Q.workers_loyalty += (Q.radicalism - 30) / 10;
Q.pensioners_urban_loyalty += (Q.moderation - 30) / 8;
Q.intelligentsia_liberal_loyalty -= (Q.fear_of_communism / 10);

// --- 2. РЕГИОНАЛЬНЫЙ ПЕРЕСЧЕТ ---
var national_sum = { yelt: 0, zyug: 0, lebe: 0, zhir: 0, yavl: 0 };
var r_count = 0;

for (var rid in Q.region_targets) {
    var target = Q.region_targets[rid];
    var current = Q.region_data[rid];

    // Дрейф к историческим результатам, модифицированный игроком
    var yelt_momentum = 0.05 * (Q.month >= 3 ? 1.5 : 1.0);
    var zyug_momentum = 0.05 * (1 + Q.media_penetration);

    current.yelt += (target.yelt - current.yelt) * yelt_momentum;
    current.zyug += (target.zyug - current.zyug) * zyug_momentum;
    current.lebe += (target.lebe - current.lebe) * 0.05;

    // Эффект админресурса Ельцина
    current.yelt += Q.yeltsin_admin_resource / 200;

    national_sum.yelt += current.yelt;
    national_sum.zyug += current.zyug;
    national_sum.lebe += current.lebe;
    r_count++;
}

Q.yeltsin_support = national_sum.yelt / r_count;
Q.zyuganov_support = national_sum.zyug / r_count;
Q.lebed_support = national_sum.lebe / r_count;
!}
