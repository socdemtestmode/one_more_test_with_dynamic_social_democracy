// --- РЕГИОНАЛЬНЫЕ ДАННЫЕ (89 Субъектов - Цели 1 тура) ---
Q.region_targets = {
    'Moscow': {yelt: 61.16, zyug: 14.85, lebe: 9.62, yavl: 7.96, zhir: 1.46},
    'St_Petersburg': {yelt: 49.6, zyug: 14.94, lebe: 14.01, yavl: 15.15, zhir: 2.15},
    'Sverdlovskaya': {yelt: 59.45, zyug: 11.66, lebe: 14.18, yavl: 5.36, zhir: 4.88},
    'Kemerovskaya': {yelt: 23.02, zyug: 38.88, lebe: 15.29, yavl: 5.34, zhir: 11.63},
    'Krasnodarskiy': {yelt: 26.26, zyug: 39.42, lebe: 17.49, yavl: 6.36, zhir: 6.38},
